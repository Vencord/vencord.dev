{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "useTabs": false,
    "tabWidth": 4,
    "trailingComma": "none",
    "semi": true,
    "printWidth": 120,
    "singleQuote": false,
    "astro": true,
    "svelte": true,
    "sortImports": true
}
