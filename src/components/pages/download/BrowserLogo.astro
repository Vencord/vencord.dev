---
export interface Props {
    browser: string;
}

const { browser } = Astro.props;

const browserName = browser
    .split("-")
    .map(w => w[0].toUpperCase() + w.slice(1))
    .join(" ");
---

<img
    class="browser-logo"
    src={`/assets/browser-logos/${browser}.svg`}
    alt={browserName}
    title={browserName}
/>

<style>
    img {
        width: 2em;
    }
</style>
