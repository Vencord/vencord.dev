---
import Tab from "./Tab.astro";
import CodeBlock from "@components/CodeBlock.svelte";
import Card, { CardKind } from "@components/Card.svelte";
import { DownloadFileNames } from "@scripts/constants";
---

<Tab fileNames={[DownloadFileNames.linux]}>
    <div slot="header">
        <p class="instruction">
            Open your terminal and run the following command. Then follow the
            instructions in your terminal.
        </p>
        <CodeBlock
            code={`sh -c "$(curl -sS ${Astro.url.origin}/install.sh)"`}
            client:load
        />

        <p class="instruction">
            Alternatively, you can also manually download the installer, make it
            executable and run it in a terminal.
        </p>
    </div>

    <section slot="footer">
        <Card kind={CardKind.Warning}>
            <p>
                Discord installed via snap is not supported. Instead, use one of
                <ul>
                    <li>
                        <a
                            href="https://flathub.org/apps/details/com.discordapp.Discord"
                        >
                            Discord Flatpak
                        </a>
                    </li>
                    <li>
                        <a href="https://discord.com/download">
                            Discord's official .deb package
                        </a>
                    </li>
                </ul>
            </p>
        </Card>
    </section>

    <style>
        h3 {
            margin: 1em 0 0.5em;
            font-size: 2em;
        }

        ul {
            margin-top: 0;
            margin-left: 1em;
            padding: 0;
        }

        p {
            margin-bottom: 0.25em;
        }

        section {
            width: 100%;
            margin-top: 1em;
        }

        .instruction {
            margin-bottom: 1em;
        }
    </style>
</Tab>
