---
import LinkButton from "@components/LinkButton.astro";

export interface ActionLink {
    href: string;
    label: string;
    title?: string;
    primary?: boolean;
}

export interface Props {
    links: ActionLink[];
}

const { links } = Astro.props;
---

<div class="actions">
    {links.map(({ href, label, title, primary }) => (
        <LinkButton href={href} class="action" primary={primary} title={title}>
            {label}
        </LinkButton>
    ))}
</div>

<style>
    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
    }

    .action {
        padding: 0.75em 1.5em;
        font-size: 0.95em;
    }
</style>
