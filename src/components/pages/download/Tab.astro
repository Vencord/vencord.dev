---
export interface Props {
    title: string;
}

const { title } = Astro.props;
---

<div class="tab">
    <header>
        <h2>{title}</h2>
    </header>

    <slot />
</div>

<style>
    header {
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--fg0-muted2);
    }

    h2 {
        margin: 0;
        font-size: 1.5em;
        line-height: 1.3;
    }
</style>
