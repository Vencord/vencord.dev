---
import type { HTMLAttributes } from "astro/types";

export interface Props extends HTMLAttributes<"a"> {
    href: string;
    primary?: boolean;
    children: any;
}

const { class: className, primary, ...props } = Astro.props;
---

<a class:list={["slop-btn", "slop-btn-lg", primary ? "slop-btn-primary" : "slop-btn-ghost", className]} {...props}>
    <slot />
</a>
